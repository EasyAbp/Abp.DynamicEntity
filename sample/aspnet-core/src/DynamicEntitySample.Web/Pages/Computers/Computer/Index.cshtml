@page
@using DynamicEntitySample.Permissions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using DynamicEntitySample.Web.Pages.Computers.Computer
@using DynamicEntitySample.Localization
@using DynamicEntitySample.Web.Menus
@using EasyAbp.Abp.DynamicEntity.Web.Bundling
@model IndexModel
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<DynamicEntitySampleResource> L
@inject IAuthorizationService Authorization
@{
    PageLayout.Content.Title = L["Menu:Computer"].Value;
    PageLayout.Content.MenuItemName = DynamicEntitySampleMenus.Computer;
}

@section scripts
{
    <abp-script src="/Pages/Computers/Computer/index.js" />
    <abp-script-bundle name="@DynamicEntityBundles.Scripts.DynamicEntity" />
}
@section styles
{
    <abp-style src="/Pages/Computers/Computer/index.css"/>
}
@section content_toolbar
{
    <abp-button id="NewComputerButton"
                text="@L["CreateComputer"].Value"
                icon="plus"
                size="Small"
                button-type="Primary" />
}

<abp-card>
    <abp-card-body>
        <abp-table striped-rows="true" id="ComputerTable" class="nowrap" />
    </abp-card-body>
</abp-card>